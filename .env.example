# 飞书企业自建应用凭证（开放平台 → 凭证与基础信息）
# 复制成 .env 再填；.env 不进 git。系统环境变量优先于 .env。
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me

# 可选：飞书登录回调地址。不填时用 http://<浏览器访问的域名>/auth/feishu/callback
# 不管填不填，都要把实际用的地址加到 开放平台 → 安全设置 → 重定向 URL
# FEISHU_REDIRECT_URI=http://onepiece.local/auth/feishu/callback

# 部署这台电脑上 Unity 工程的 Client 目录（下面要有 Assets）。不填时用 D:\Fork\onepiece_engine\Client
# PROJECT_ROOT=/Users/tools/Project/onepiece/Client
# 允许查询的 Git 分支，逗号分隔；main 总会带上。不填时 main,CBT2_bugfix
# GIT_BRANCHES=main,CBT2_bugfix

# 大模型（智谱）。不填模型时用 glm-4.5-flash / glm-4.6v-flash
# LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.5-flash
# LLM_VISION_MODEL=glm-4.6v-flash

# 回答用哪个 AI：codex（本机 Codex CLI，默认）或 glm（智谱，要上面的 LLM_API_KEY）。Codex 没装时自动退回智谱
# AI_PROVIDER=codex
# 留空 = 在 PATH 里找 codex
# CODEX_PATH=
# CODEX_MODEL=gpt-6.1-sol
# CODEX_REASONING_EFFORT=medium
# 同时最多几个 Codex 进程
# CODEX_CONCURRENCY=2
# 单次回答超时（秒），默认 300
# AI_TIMEOUT_SECONDS=300
# true 时加载 ~/.codex/config.toml（MCP、插件），每次慢几秒
# CODEX_USE_USER_CONFIG=false

# 网页聊天的飞书知识库：后台定期从这个目录（例如 FeishuKonwledgeBot 的 data/wiki）同步到项目的 wiki/
# WIKI_SOURCE_DIR=/Users/tools/Project/FeishuKonwledgeBot/data/wiki
# 同步间隔（分钟），默认 30
# WIKI_SYNC_MINUTES=30

# 监修文档监听：配置放 data/doc_watch/config.json（enabled、docs、admins、clarify、digest…）和 mapping.json（归因规则），
# 不放就不启动。手动检查一次：.venv/bin/python -m bot --doc-watch [--dry-run] [--force] [--digest]

# CICD 打包通知 + AI 报错分析：打包机失败后 POST 到 http://HOST:PORT/cicd/analyze，成功卡片 POST 到 /cicd/card
# CICD_ANALYZE_ENABLED=true
# CICD_ANALYZE_HOST=10.234.30.83
# CICD_ANALYZE_PORT=3210
# 和打包机环境变量 CICD_AI_TOKEN 保持一致；留空则局域网内谁都能调用
# CICD_ANALYZE_TOKEN=
# 打包机最多等 120 秒：AI 单次超时（默认 105）、整体答复限时（默认 100）
# CICD_AI_TIMEOUT_SECONDS=105
# CICD_REPLY_BUDGET_SECONDS=100
# 打包失败时除了触发人，额外 @ 的人（飞书姓名，逗号隔开）；按管线额外 @ 的人在 data/cicd/config.json 的 pipelineAt
# CICD_FAILURE_ALSO_AT=
# 打包群：默认按群名找；也可以在群里 @大豆 发 /打包群
# CICD_NOTIFY_CHAT_NAME=打包机器人
# CICD_NOTIFY_CHAT_ID=
# Zeus 热更提醒：打包群里出现「Zeus热更系统提醒」卡片就回复 @所有人
# ZEUS_WATCH_ENABLED=true
# ZEUS_WATCH_SECONDS=30
